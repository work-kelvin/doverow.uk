<section class="collection-banner">
  <div class="page-width">
    <h1 class="collection-banner__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="collection-banner__count">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="page-width product-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'all' -%}
        <a class="product-card" href="{{ collection.url }}">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              {{
                collection.featured_image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '360, 720, 900', sizes: '(min-width: 900px) 30vw, 45vw', alt: collection.title
              }}
            {%- else -%}
              <div class="product-card__placeholder">
                <img src="{{ 'doverow.png' | asset_url }}" width="80" height="72" alt="">
              </div>
            {%- endif -%}
          </div>
          <div class="product-card__meta">
            <span class="product-card__title">{{ collection.title }}</span>
            <span class="product-card__price">
              {{ 'collections.product_count' | t: count: collection.products_count }}
            </span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": "Browse by category."
    }
  ]
}
{% endschema %}
