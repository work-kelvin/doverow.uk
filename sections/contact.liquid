<section class="rich-text">
  <div class="page-width">
    <div class="rich-text__inner">
      <h1 class="rich-text__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="rich-text__body">{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="contact-list">
        {%- if section.settings.instagram_primary != blank -%}
          <li>
            <span class="contact-label">{{ 'contact.instagram' | t }}</span>
            <a href="https://instagram.com/{{ section.settings.instagram_primary | remove: '@' }}" target="_blank" rel="noopener">
              @{{ section.settings.instagram_primary | remove: '@' }}
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.instagram_secondary != blank -%}
          <li>
            <span class="contact-label">{{ 'contact.instagram' | t }}</span>
            <a href="https://instagram.com/{{ section.settings.instagram_secondary | remove: '@' }}" target="_blank" rel="noopener">
              @{{ section.settings.instagram_secondary | remove: '@' }}
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <li>
            <span class="contact-label">{{ 'contact.email' | t }}</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>For orders, press, and studio notes.</p>"
    },
    {
      "type": "text",
      "id": "instagram_primary",
      "label": "Instagram handle",
      "default": "lovedoverow"
    },
    {
      "type": "text",
      "id": "instagram_secondary",
      "label": "Secondary Instagram",
      "default": "sea___ofdesires"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "love@doverow.uk"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
