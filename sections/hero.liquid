<section class="hero" data-hero>
  <div class="hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          alt: ''
      }}
    {%- else -%}
      <img
        src="{{ 'hero-splash.jpg' | asset_url }}"
        alt=""
        width="1920"
        height="1080"
        loading="eager"
      >
    {%- endif -%}
    <div class="hero__shade"></div>
  </div>

  <div class="hero__content">
    <div class="hero__brand-row">
      <img
        class="hero__mark"
        src="{{ 'doverow.png' | asset_url }}"
        width="48"
        height="44"
        alt=""
      >
      <span class="visually-hidden">{{ shop.name }}</span>
    </div>

    <h1 class="hero__title">{{ section.settings.heading | default: shop.name }}</h1>

    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a class="button button--secondary" href="{{ section.settings.secondary_link }}">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Doverow"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Personal artifacts and collectible objects."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "About"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
