<div
  class="cart-drawer"
  id="CartDrawer"
  data-cart-drawer
  aria-hidden="true"
>
  <div class="cart-drawer__overlay" data-cart-close tabindex="-1"></div>
  <aside
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
    data-cart-panel
  >
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
        ×
      </button>
    </div>

    <div class="cart-drawer__items" data-cart-items>
      {%- if cart.item_count == 0 -%}
        <p class="cart-empty">{{ 'cart.empty' | t }}</p>
      {%- else -%}
        {%- for item in cart.items -%}
          <article class="cart-item" data-cart-item data-key="{{ item.key }}">
            <div class="cart-item__media">
              {%- if item.image -%}
                {%- assign cart_item_alt = item.product.title | escape -%}
                {{
                  item.image
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', alt: cart_item_alt
                }}
              {%- endif -%}
            </div>
            <div>
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              <div class="cart-item__actions">
                <input
                  class="cart-item__qty"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="{{ 'cart.quantity' | t }}"
                  data-cart-qty
                  data-key="{{ item.key }}"
                >
                <button type="button" class="cart-item__remove" data-cart-remove data-key="{{ item.key }}">
                  {{ 'cart.remove' | t }}
                </button>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="cart-drawer__footer" {% if cart.item_count == 0 %}hidden{% endif %} data-cart-footer>
      <div class="cart-drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>
      <a class="button" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="button button--secondary" style="width: 100%;">
          {{ 'cart.checkout' | t }}
        </button>
      </form>
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
